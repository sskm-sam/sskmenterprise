<%- include('partials/header') %>

<section class="max-w-7xl mx-auto px-6 py-16">
  <div class="max-w-3xl mb-12">
    <span class="text-sky-400 text-xs font-bold uppercase tracking-widest">Substantiated Proof</span>
    <h1 class="text-3xl sm:text-5xl font-black text-white mt-2 mb-4">
      Enterprise Case Studies & Transformations
    </h1>
    <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
      Proven architecture, integration, and delivery outcomes for multi-national organizations across North America.
    </p>
  </div>

  <div class="space-y-8 mb-16">
    <!-- Case Study 1 -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 hover:border-slate-700 transition">
      <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-800 mb-6">
        <div>
          <span class="text-[11px] font-bold text-sky-400 uppercase tracking-wider">Global Life Sciences & Healthcare — North America</span>
          <h2 class="text-2xl font-bold text-white mt-1">Hybrid Cloud Integration & SAP PO/PI Modernization</h2>
        </div>
        <span class="text-xs px-3 py-1 rounded-full bg-slate-800 border border-slate-700 text-slate-300">Multi-Country Delivery</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs sm:text-sm">
        <div>
          <h4 class="font-bold text-white mb-2 uppercase text-[11px] tracking-wider text-slate-400">The Challenge</h4>
          <p class="text-slate-400 leading-relaxed">Monolithic SAP PO landscape with 250+ custom point-to-point interfaces, causing high maintenance overhead and release bottlenecks.</p>
        </div>
        <div>
          <h4 class="font-bold text-white mb-2 uppercase text-[11px] tracking-wider text-slate-400">The SSKM Approach</h4>
          <p class="text-slate-400 leading-relaxed">Standardized API patterns on SAP CPI, decoupled legacy custom code, and introduced automated regression monitoring.</p>
        </div>
        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800/80">
          <h4 class="font-bold text-sky-400 mb-2 uppercase text-[11px] tracking-wider">Measurable Results</h4>
          <ul class="text-slate-300 space-y-1.5 text-xs">
            <li>&bull; <strong>45% reduction</strong> in interface deployment cycle times.</li>
            <li>&bull; <strong>Zero unplanned downtime</strong> during migration cutover.</li>
            <li>&bull; Full compliance with healthcare GxP validation standards.</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Case Study 2 -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 hover:border-slate-700 transition">
      <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-800 mb-6">
        <div>
          <span class="text-[11px] font-bold text-indigo-400 uppercase tracking-wider">Heavy Equipment & Manufacturing — Canada & USA</span>
          <h2 class="text-2xl font-bold text-white mt-1">SAP S/4HANA Order-to-Cash Supply Chain Architecture</h2>
        </div>
        <span class="text-xs px-3 py-1 rounded-full bg-slate-800 border border-slate-700 text-slate-300">S/4HANA Migration</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs sm:text-sm">
        <div>
          <h4 class="font-bold text-white mb-2 uppercase text-[11px] tracking-wider text-slate-400">The Challenge</h4>
          <p class="text-slate-400 leading-relaxed">Disparate ERP instances across regional operating units impeding single-pane visibility for supply chain operations.</p>
        </div>
        <div>
          <h4 class="font-bold text-white mb-2 uppercase text-[11px] tracking-wider text-slate-400">The SSKM Approach</h4>
          <p class="text-slate-400 leading-relaxed">Designed unified enterprise target architecture, harmonized master data schemas, and governed multi-vendor delivery.</p>
        </div>
        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800/80">
          <h4 class="font-bold text-indigo-400 mb-2 uppercase text-[11px] tracking-wider">Measurable Results</h4>
          <ul class="text-slate-300 space-y-1.5 text-xs">
            <li>&bull; <strong>30% acceleration</strong> in monthly financial close.</li>
            <li>&bull; Multi-region inventory consolidation on a single core.</li>
            <li>&bull; Standardized ARB governance adopted enterprise-wide.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>