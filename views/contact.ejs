<%- include('partials/header') %>

<section class="max-w-3xl mx-auto px-6 py-16">
  <div class="text-center mb-10">
    <h1 class="text-3xl font-extrabold text-white">Contact SSKM ENTERPRISE
Solutions & Media Inc.</h1>
    <p class="text-sm text-slate-400 mt-2">Connect with our enterprise consulting practice or creative media production division.</p>
  </div>

  <% if (sent) { %>
    <div class="mb-8 p-4 rounded-xl border border-emerald-500/50 bg-emerald-950/40 text-emerald-300 text-sm text-center">
      <i class="fa-solid fa-circle-check mr-2"></i> Thank you! Your message has been received. Our team will get back to you shortly.
    </div>
  <% } %>

  <form action="/contact" method="POST" class="bg-slate-900 border border-slate-800 rounded-2xl p-8 space-y-6 shadow-xl">
    <div>
      <label class="block text-xs font-semibold text-slate-300 mb-2 uppercase tracking-wider">Full Name</label>
      <input type="text" name="name" required placeholder="John Doe" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-400">
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-300 mb-2 uppercase tracking-wider">Email Address</label>
      <input type="email" name="email" required placeholder="john@enterprise.com" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-400">
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-300 mb-2 uppercase tracking-wider">Service Division</label>
      <select name="division" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-400">
        <option value="Project Placements">Project Placements & Talent Delivery</option>
        <option value="Training & Upskilling">Training & Upskilling</option>
        <option value="Web Applications">Web Applications & Digital Solutions</option>
        <option value="Enterprise Integration">Enterprise Integration (Middleware, APIs, EDI, SAP)</option>
        <option value="Media Services">Media Services (Film Production, Directing, Audio Post)</option>
        <option value="General Inquiry">General Executive Inquiries</option>
      </select>
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-300 mb-2 uppercase tracking-wider">Project / Inquiry Overview</label>
      <textarea name="message" rows="4" required placeholder="Provide brief details about your enterprise requirements or media project..." class="w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-400"></textarea>
    </div>

    <button type="submit" class="w-full py-3 rounded-lg bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 font-bold text-slate-950 text-sm tracking-wider uppercase shadow-md transition duration-200">
      Submit Inquiry
    </button>
  </form>
</section>

<%- include('partials/footer') %>