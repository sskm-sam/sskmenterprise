<%- include('partials/header') %>

<section class="max-w-7xl mx-auto px-6 py-16">
  <!-- Hero Section -->
  <div class="max-w-3xl mb-16">
    <span class="text-amber-400 text-xs font-bold uppercase tracking-widest">Our Story & Leadership</span>
    <h1 class="text-4xl sm:text-5xl font-black text-white mt-2 mb-6">
      Architecture with Structure. Cinema with Soul.
    </h1>
    <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
      SSKM Enterprise Solutions & Media Inc. unites two disciplines: high-stakes enterprise systems architecture and evocative visual storytelling.
    </p>
  </div>

  <!-- Vision & Mission Statements -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
    <!-- Vision Statement -->
    <div class="p-8 rounded-2xl border border-slate-800 bg-gradient-to-b from-slate-900/80 to-slate-950/90 shadow-xl flex flex-col justify-between">
      <div>
        <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/20 flex items-center justify-center text-xl mb-6">
          <i class="fa-solid fa-compass"></i>
        </div>
        <span class="text-xs uppercase font-bold tracking-widest text-amber-400 block mb-2">Strategic Direction</span>
        <h2 class="text-2xl font-bold text-white mb-4">Vision Statement</h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          To become a trusted provider of innovative enterprise solutions and media services that empower organizations and individuals to achieve sustainable growth through technology, knowledge, and digital transformation.
        </p>
      </div>
      <div class="mt-8 pt-4 border-t border-slate-800/80 flex items-center gap-2 text-xs font-semibold text-slate-400">
        <i class="fa-solid fa-circle-check text-amber-400"></i> Sustainable Growth & Digital Transformation
      </div>
    </div>

    <!-- Mission Statement -->
    <div class="p-8 rounded-2xl border border-slate-800 bg-gradient-to-b from-slate-900/80 to-slate-950/90 shadow-xl flex flex-col justify-between">
      <div>
        <div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 flex items-center justify-center text-xl mb-6">
          <i class="fa-solid fa-bullseye"></i>
        </div>
        <span class="text-xs uppercase font-bold tracking-widest text-indigo-400 block mb-2">Our Commitment</span>
        <h2 class="text-2xl font-bold text-white mb-4">Mission Statement</h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          SSKM Enterprise Solutions & Media Inc. delivers strategic consulting, technology solutions, digital media services, training, and innovation programs that help businesses improve efficiency, strengthen their brand presence, and embrace the future of work.
        </p>
      </div>
      <div class="mt-8 pt-4 border-t border-slate-800/80 flex items-center gap-2 text-xs font-semibold text-slate-400">
        <i class="fa-solid fa-circle-check text-indigo-400"></i> Empowering the Future of Work
      </div>
    </div>
  </div>

  <!-- Detailed Story Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-20">
    <div class="lg:col-span-6 relative">
      <div class="rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-900">
        <img 
          src="/images/about-us.png" 
          alt="SSKM Leadership and Studio" 
          class="w-full h-96 object-cover object-center"
          width="1200"
          height="800"
          loading="lazy"
          decoding="async"
          onerror="this.src='https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1000&q=80'"
        />
      </div>
    </div>
    <div class="lg:col-span-6 space-y-6">
      <h2 class="text-2xl sm:text-3xl font-bold text-white">Three Decades of Engineering & Artistic Innovation</h2>
      <p class="text-slate-300 text-sm leading-relaxed">
        Founded on three decades of international experience in enterprise solutions, IT architecture, and SAP delivery, SSKM brings rigorous execution to Fortune 500-level transformations.
      </p>
      <p class="text-slate-300 text-sm leading-relaxed">
        Simultaneously, our media banner operates as an independent creative house—producing character-driven films, retro-inspired aesthetic treatments, script doctoring, and polished audio mastering.
      </p>
      <div class="border-l-2 border-amber-400 pl-4 py-1 text-sm italic text-slate-300">
        "Whether architecting a distributed cloud backbone or directing a cinematic sequence, the standard remains identical: flawless design and lasting impact."
      </div>
    </div>
  </div>

  <!-- Management -->
  <div class="mb-20">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div class="max-w-3xl">
        <span class="text-sky-400 text-xs font-bold uppercase tracking-widest">Management</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">Leadership grounded in delivery</h2>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed mt-3">
          SSKM is guided by experienced leaders who connect enterprise strategy, operational discipline, and creative execution.
        </p>
      </div>
      <a href="/management" class="shrink-0 text-sm text-sky-400 hover:text-sky-300 font-semibold transition-colors">View executive management &rarr;</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="p-7 rounded-2xl border border-slate-800 bg-gradient-to-b from-slate-900 to-slate-950 shadow-xl">
        <div class="flex items-start gap-4 mb-5">
          <div class="w-12 h-12 shrink-0 rounded-xl bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center text-xl">
            <i class="fa-solid fa-user-tie"></i>
          </div>
          <div>
            <span class="text-xs uppercase font-bold tracking-widest text-sky-400">Founder & President</span>
            <h3 class="text-xl font-bold text-white mt-1">Satya Siva Kumar Mandiga</h3>
            <p class="text-xs text-slate-400 mt-1">Director & Principal Consultant</p>
          </div>
        </div>
        <p class="text-sm text-slate-300 leading-relaxed">
          Leads enterprise architecture, SAP transformation, CIO advisory, corporate training, and creative media direction with more than three decades of global IT experience.
        </p>
      </div>

      <div class="p-7 rounded-2xl border border-slate-800 bg-gradient-to-b from-slate-900 to-slate-950 shadow-xl">
        <div class="flex items-start gap-4 mb-5">
          <div class="w-12 h-12 shrink-0 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center text-xl">
            <i class="fa-solid fa-briefcase"></i>
          </div>
          <div>
            <span class="text-xs uppercase font-bold tracking-widest text-amber-400">Co-Founder & Director</span>
            <h3 class="text-xl font-bold text-white mt-1">Sudha Rani Mandiga</h3>
            <p class="text-xs text-slate-400 mt-1">Director & Producer</p>
          </div>
        </div>
        <p class="text-sm text-slate-300 leading-relaxed">
          Directs operations, client coordination, vendor partnerships, financial administration, training programs, and digital media release activities.
        </p>
      </div>
    </div>
  </div>

  <!-- Pillars -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/60">
      <div class="w-10 h-10 rounded-lg bg-sky-500/10 text-sky-400 flex items-center justify-center text-lg mb-4">
        <i class="fa-solid fa-sitemap"></i>
      </div>
      <h3 class="text-lg font-bold text-white mb-2">Systems Architecture</h3>
      <p class="text-xs text-slate-400 leading-relaxed">
        Designing scalable, resilient SAP and multi-cloud middleware landscapes built for zero downtime and secure integration.
      </p>
    </div>
    <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/60">
      <div class="w-10 h-10 rounded-lg bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-lg mb-4">
        <i class="fa-solid fa-diagram-project"></i>
      </div>
      <h3 class="text-lg font-bold text-white mb-2">Delivery Governance</h3>
      <p class="text-xs text-slate-400 leading-relaxed">
        Rigorous delivery frameworks, compliance verification, and stakeholder alignment for cross-border programs.
      </p>
    </div>
    <div class="p-6 rounded-xl border border-slate-800 bg-slate-900/60">
      <div class="w-10 h-10 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center text-lg mb-4">
        <i class="fa-solid fa-clapperboard"></i>
      </div>
      <h3 class="text-lg font-bold text-white mb-2">Cinematic Craft</h3>
      <p class="text-xs text-slate-400 leading-relaxed">
        Original storytelling, screenplay craftsmanship, color-accurate post-production, and professional sound design.
      </p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>