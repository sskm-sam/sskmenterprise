<%- include('partials/header') %>

<section class="max-w-7xl mx-auto px-6 py-16">
  <!-- Page Header -->
  <div class="max-w-3xl mb-12">
    <span class="text-amber-400 text-xs font-bold uppercase tracking-widest">Cinema & Digital Media Production</span>
    <h1 class="text-3xl sm:text-5xl font-black text-white mt-2 mb-4">
      Cinematic Storytelling & Digital Media Networks
    </h1>
    <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
      From original film direction and audio engineering to active digital video networks reaching global diaspora audiences, our creative division brings stories to life.
    </p>
  </div>

  <!-- Featured YouTube Channels Banner -->
  <div class="mb-20">
    <div class="flex items-center justify-between mb-8 pb-3 border-b border-slate-800">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-red-500 mb-1">
          <i class="fa-brands fa-youtube text-base"></i> Established Broadcast Network
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Our YouTube Channels</h2>
      </div>
      <span class="hidden sm:inline-block text-xs text-slate-400">Streamed Worldwide</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <% channels.forEach(channel => { %>
        <div class="relative bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 border border-slate-800 rounded-2xl p-8 hover:border-red-500/50 shadow-2xl transition duration-300 flex flex-col justify-between">
          
          <div>
            <!-- Channel Header & Badge -->
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="flex items-center space-x-3">
                <div class="w-12 h-12 rounded-xl bg-red-600/10 border border-red-500/30 text-red-500 flex items-center justify-center text-xl">
                  <i class="<%= channel.icon %>"></i>
                </div>
                <div>
                  <h3 class="text-lg sm:text-xl font-bold text-white"><%= channel.name %></h3>
                  <span class="text-xs text-slate-400"><%= channel.handle %></span>
                </div>
              </div>
              <span class="text-[10px] uppercase font-bold tracking-wider px-2.5 py-1 rounded-full bg-red-950/70 border border-red-800/80 text-red-300 whitespace-nowrap">
                <%= channel.badge %>
              </span>
            </div>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
              <%= channel.description %>
            </p>

            <!-- Key Highlight Badge -->
            <div class="mb-6 p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 flex items-center gap-2.5">
              <i class="fa-solid fa-circle-play text-red-400 text-sm"></i>
              <span class="text-xs font-medium text-slate-300"><%= channel.highlight %></span>
            </div>
          </div>

          <!-- Channel Action Buttons -->
          <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
            <span class="text-xs text-slate-400 flex items-center gap-1.5">
              <i class="fa-solid fa-tag text-[10px] text-amber-400"></i> <%= channel.category %>
            </span>
            <a 
              href="<%= channel.url %>" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-red-600 hover:bg-red-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-red-950 transition"
            >
              <i class="fa-brands fa-youtube"></i> Visit Channel
            </a>
          </div>

        </div>
      <% }) %>
    </div>
  </div>

  <!-- Media Production Services Header -->
  <div class="mb-8">
    <span class="text-amber-400 text-xs font-bold uppercase tracking-widest">End-to-End Capabilities</span>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">Creative & Technical Studio Services</h2>
  </div>

  <!-- Studio Services Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
    <% services.forEach(service => { %>
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 hover:border-amber-500/40 transition flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-lg bg-amber-950 text-amber-400 flex items-center justify-center text-lg mb-4">
            <i class="<%= service.icon %>"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2"><%= service.title %></h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4"><%= service.description %></p>
        </div>
        
        <div class="border-t border-slate-800 pt-3">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block mb-2">Scope of Services</span>
          <div class="flex flex-wrap gap-1.5">
            <% service.tags.forEach(tag => { %>
              <span class="text-[11px] px-2.5 py-1 rounded-md bg-slate-800 text-amber-300 border border-slate-700">
                <%= tag %>
              </span>
            <% }) %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Media Collaboration CTA -->
  <div class="bg-gradient-to-r from-amber-950/40 to-slate-900 border border-amber-800/40 rounded-2xl p-8 flex flex-col md:flex-row justify-between items-center gap-6">
    <div>
      <h3 class="text-xl font-bold text-white">Collaborate on a Film or Digital Project</h3>
      <p class="text-slate-400 text-xs sm:text-sm mt-1">Screenplays, directorial collaborations, post-production audio, or sponsorship partnerships.</p>
    </div>
    <a href="/contact?division=media" class="px-6 py-3 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition whitespace-nowrap">
      Initiate Creative Discussion
    </a>
  </div>
</section>

<%- include('partials/footer') %>